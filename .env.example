# ─────────────────────────────────────────────────────────────────────────
#  Domain Finder · variables de entorno
#  Copia este archivo a `.env` y rellena las claves que vayas a usar.
#  El archivo `.env` está en .gitignore y NUNCA se sube al repositorio
#  para evitar que las plataformas bloqueen tus claves.
#
#  IMPORTANTE: deja siempre las claves dentro de variables (NO las
#  pegues directamente en el código). El software solo las lee a través
#  de os.getenv() y este `.env`.
# ─────────────────────────────────────────────────────────────────────────

# ── BÚSQUEDA Y ANÁLISIS DE WEBS ─────────────────────────────────────────
# Serper.dev — búsqueda en Google (obligatoria para que funcione la
# extracción de dominios). https://serper.dev
SERPER_API_KEY=

# Google PageSpeed Insights — opcional. Solo se usa en la Fase 2 del
# modo precisión cuando el router de IA decide que es necesaria.
# Sin esta clave el sistema sigue funcionando sin PageSpeed.
# https://developers.google.com/speed/docs/insights/v5/get-started
PAGESPEED_API_KEY=


# ── CADENAS DE FALLBACK DE IA ───────────────────────────────────────────
# Cada tarea (análisis de prompt, generación de queries, validación
# final) tiene su propio orden de prioridad de proveedores. Si la clave
# del primer proveedor falta o falla, el sistema salta al siguiente sin
# error. Las claves se cargan desde aquí.

# Groq Cloud — https://console.groq.com/keys
# Usado como #1 en análisis y como fallback en queries / validación.
GROQ_API_KEY=

# SambaNova Cloud — https://cloud.sambanova.ai/
# Usado como #1 en generación de queries y como #2 en análisis.
SAMBANOVA_API_KEY=

# Cerebras Cloud — https://cloud.cerebras.ai/
# Usado como #1 en la validación final.
CEREBRAS_API_KEY=

# Google Gemini — https://aistudio.google.com/apikey
# Usado como #3 (fallback general) en todas las cadenas.
GEMINI_API_KEY=


# ── MODELOS (OPCIONAL) ─────────────────────────────────────────────────
# Los IDs de modelo de los proveedores CADUCAN cada pocos meses. Si un
# modelo deja de funcionar, cambia SOLO el valor aquí (sin tocar código).
# Deja en blanco para usar los defaults vivos a jul-2026.
#
# Defaults actuales (todos verificados vivos jul-2026):
#   GROQ_MODEL_LARGE   → llama-3.3-70b-versatile   (el 3.1-70B murió ene-2025)
#   GROQ_MODEL_SMALL   → llama-3.1-8b-instant
#   SAMBANOVA_MODEL    → Meta-Llama-3.3-70B-Instruct (el 405B murió jun-2025)
#   CEREBRAS_MODEL     → llama3.1-8b
#   CEREBRAS_MODEL_LARGE → llama-3.3-70b
#   GEMINI_MODEL       → gemini-2.5-flash          (el 1.5-flash murió, 404)
#
# Alternativas estables si algún default caduca:
#   GROQ_MODEL_LARGE=openai/gpt-oss-120b
#   GROQ_MODEL_SMALL=openai/gpt-oss-20b
#   SAMBANOVA_MODEL=DeepSeek-V3.1
#   GEMINI_MODEL=gemini-3.5-flash
GROQ_MODEL_LARGE=
GROQ_MODEL_SMALL=
SAMBANOVA_MODEL=
CEREBRAS_MODEL=
CEREBRAS_MODEL_LARGE=
GEMINI_MODEL=


# ── CLAVE PROPIA DEL USUARIO (FALLBACK FINAL) ──────────────────────────
# Si configuras tu propia clave de un endpoint compatible con la API de
# OpenAI (chat/completions), se usará como ÚLTIMO recurso en cada cadena
# antes de fallar. Sirve para tener tu cuota privada y que el sistema
# siga funcionando aunque los providers gratuitos estén saturados.
#
# Compatible con: OpenAI, OpenRouter, Mistral, Together, DeepSeek,
# Anthropic (vía OpenAI compat), Anyscale, Fireworks, etc.
USER_OWN_API_KEY=
# URL base SIN /chat/completions (ej. "https://api.openai.com/v1").
# Defaults a "https://api.openai.com/v1" si se deja en blanco.
USER_OWN_BASE_URL=
# Nombre del modelo (ej. "gpt-4o-mini", "openrouter/auto",
# "mistral-large-latest"). Defaults a "gpt-4o-mini".
USER_OWN_MODEL=
# Nombre legible para mostrar en logs (ej. "OpenAI", "OpenRouter").
# Defaults a "UserOwn".
USER_OWN_PROVIDER_NAME=
